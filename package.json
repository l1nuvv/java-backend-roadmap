{
  "name": "java-backend-roadmap",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && node tests/cloud.browser.cjs",
